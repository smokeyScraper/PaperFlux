# Analyst agent (deep explanation). Use a dedicated Gemini key.
GEMINI_ANALYST_API_KEY=
# Optional extras for rotation: GEMINI_ANALYST_API_KEY2=
GEMINI_ANALYST_MODEL=gemini-3.5-flash

# Insights/diagrams agent. Use a *different* Gemini key so both can run Flash.
GEMINI_INSIGHTS_API_KEY=
# Optional extras for rotation: GEMINI_INSIGHTS_API_KEY2=
GEMINI_INSIGHTS_MODEL=gemini-3.5-flash

# Legacy fallback if the agent-specific keys above are empty
# GEMINI_API_KEY1=
# GEMINI_API_KEY2=

# MongoDB
MONGODB_URI=
DB_NAME=papers_summary_database
COLLECTION_NAME=papers
METADATA_COLLECTION=metadata

# Parallel papers (each paper still runs analyst, then insights)
PAPERFLUX_MAX_WORKERS=2
