# ── Gemini (free tier) ────────────────────────────────────────────────────────
# Free-tier limits are per Google Cloud PROJECT and per MODEL (not per key):
#   gemini-3.8-flash / 3.6-flash : ~5 requests/min, ~20 requests/day
#   gemini-3.5-flash-lite / 3.1-flash-lite : ~500 requests/day
# Two keys from the SAME project share one quota. Create keys in different projects
# (AI Studio -> Create API key -> "Create API key in new project") to add capacity.
GEMINI_ANALYST_API_KEY=your_analyst_gemini_key
# Optional extras (different projects): GEMINI_ANALYST_API_KEY2=...
GEMINI_INSIGHTS_API_KEY=your_insights_gemini_key
# Optional extras (different projects): GEMINI_INSIGHTS_API_KEY2=...

# Ordered fallback chains (comma separated). When a model's daily quota is spent, or a
# model id no longer exists, the next one is tried automatically. These are the defaults:
# GEMINI_ANALYST_MODELS=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
# GEMINI_INSIGHTS_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.8-flash
# Legacy single-model variables still work and are tried first:
# GEMINI_ANALYST_MODEL=...   GEMINI_INSIGHTS_MODEL=...

# Client-side requests-per-minute used to avoid 429s (paid tiers can raise these a lot):
# GEMINI_RPM_OVERRIDES=gemini-3.8-flash=5,gemini-3.5-flash-lite=15

# Legacy fallback if the agent-specific keys above are empty
# GEMINI_API_KEY1=...
# GEMINI_API_KEY2=...

# ── Optional second provider for the text-only insights planner ───────────────
# Used only when Gemini quota is spent. Any OpenAI-compatible endpoint works.
# Setting GROQ_API_KEY alone is enough (free plan: gpt-oss-120b, ~1,000 requests/day).
# GROQ_API_KEY=...
# FALLBACK_LLM_BASE_URL=https://api.groq.com/openai/v1
# FALLBACK_LLM_API_KEY=...
# FALLBACK_LLM_MODEL=openai/gpt-oss-120b

# ── Budget ────────────────────────────────────────────────────────────────────
# Papers per day (top by upvotes). Each paper costs ~2 requests (analyst + insights).
PAPERFLUX_MAX_PAPERS=10
# Parallel papers (the rate limiter still enforces each model's RPM)
PAPERFLUX_MAX_WORKERS=2
# Send the PDF to the insights call too (better number grounding, more input tokens)
PAPERFLUX_INSIGHTS_ATTACH_PDF=1

# ── Podcasts (two-host audio conversation per paper) ──────────────────────────
# Script: a text model (Flash-Lite first). Audio: ONE multi-speaker TTS request per episode.
# Free-tier TTS is ~3 requests/min, 10K tokens/min, 10 requests/day, so at most 10 episodes
# a day (failed requests count too). Audio is stored as MP3 in MongoDB GridFS (~0.5 MB/min).
PAPERFLUX_PODCASTS=1
PAPERFLUX_PODCASTS_PER_DAY=10
# Script length (~140 spoken words per minute; 700 is about 5 minutes)
# PAPERFLUX_PODCAST_WORDS=700
# Podcasts need their OWN key and stay off without one: they never borrow the analyst/insights
# keys, whose quota the daily papers need. Create it in a NEW project (AI Studio -> Create API
# key -> "Create API key in new project"); a second key in an existing project shares its quota.
# One key covers both the script writer and TTS (different models, separate quota buckets).
GEMINI_PODCAST_API_KEY=your_podcast_gemini_key
# Optional: give TTS a project of its own (otherwise it uses GEMINI_PODCAST_API_KEY)
# GEMINI_TTS_API_KEY=...
# Defaults; confirm the TTS model id in AI Studio (unknown ids are skipped automatically):
# GEMINI_PODCAST_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.6-flash
# GEMINI_TTS_MODELS=gemini-3.8-flash-tts,gemini-3.8-flash-preview-tts
# Hosts and their Gemini prebuilt voices (calm defaults: "Gentle" and "Smooth")
# PAPERFLUX_HOST_FEMALE=Maya   GEMINI_TTS_VOICE_FEMALE=Vindemiatrix
# PAPERFLUX_HOST_MALE=Theo     GEMINI_TTS_VOICE_MALE=Algieba

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/paperflux
DB_NAME=papers_summary_database
COLLECTION_NAME=papers
METADATA_COLLECTION=metadata
